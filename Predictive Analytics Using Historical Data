import numpy as np
import pandas as pd
import plotly.graph_objects as go
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_absolute_error, r2_score
import streamlit as st

# Page Configuration
st.set_page_config(
    page_title="Predictive Analytics | Task 3", layout="wide"
)

st.title("📈 Predictive Analytics & Trend Forecasting")
st.caption("Submitted for Thiranex Data Analytics Internship - Task 3")

# 1. Sidebar Setup & File Upload
st.sidebar.header("📁 Data Source")
uploaded_file = st.sidebar.file_uploader(
    "Upload CSV with 'Date' and 'Sales'", type=["csv", "xlsx"]
)


@st.cache_data
def generate_sample_data():
    # Generate 180 days of historical sales data with a growth trend
    dates = pd.date_range(start="2026-01-01", periods=180, freq="D")
    np.random.seed(42)
    base_sales = np.linspace(500, 2500, 180)
    noise = np.random.normal(0, 150, 180)
    sales = base_sales + noise
    return pd.DataFrame({"Date": dates, "Sales": sales})


if uploaded_file is not None:
    df = (
        pd.read_csv(uploaded_file)
        if uploaded_file.name.endswith(".csv")
        else pd.read_excel(uploaded_file)
    )
    st.sidebar.success("Custom Dataset Loaded!")
else:
    df = generate_sample_data()
    st.sidebar.info("Using Sample Dataset")

# Preprocessing
df["Date"] = pd.to_datetime(df["Date"])
df = df.sort_values("Date").dropna()

# 2. Sidebar Forecasting Settings
st.sidebar.header("⚙️ Forecast Settings")
forecast_days = st.sidebar.slider(
    "Select Days to Forecast:", min_value=7, max_value=90, value=30
)

# 3. Model Training (Linear Regression)
df["DayIndex"] = (df["Date"] - df["Date"].min()).dt.days
X = df[["DayIndex"]]
y = df["Sales"]

model = LinearRegression()
model.fit(X, y)

# Historical Predictions & Metrics
df["Predicted_Sales"] = model.predict(X)
r2 = r2_score(y, df["Predicted_Sales"])
mae = mean_absolute_error(y, df["Predicted_Sales"])

# 4. Future Trend Forecasting
last_date = df["Date"].max()
future_dates = pd.date_range(
    start=last_date + pd.Timedelta(days=1), periods=forecast_days, freq="D"
)
future_days_index = (
    pd.Series(future_dates) - df["Date"].min()
).dt.days.values.reshape(-1, 1)

future_predictions = model.predict(future_days_index)
future_df = pd.DataFrame(
    {"Date": future_dates, "Sales": future_predictions, "Type": "Forecast"}
)

# 5. Display KPI Metrics
col1, col2, col3 = st.columns(3)
col1.metric("Model R² Accuracy Score", f"{r2:.2f}")
col2.metric("Mean Absolute Error (MAE)", f"${mae:.2f}")
col3.metric("Forecast Horizon", f"{forecast_days} Days")

st.markdown("---")

# 6. Interactive Visualization
st.subheader("📊 Historical Data vs. Future Sales Forecast")

fig = go.Figure()

# Plot Actual Sales
fig.add_trace(
    go.Scatter(
        x=df["Date"],
        y=df["Sales"],
        mode="lines",
        name="Actual Sales",
        line=dict(color="#1f77b4"),
    )
)

# Plot Historical Trend Fit
fig.add_trace(
    go.Scatter(
        x=df["Date"],
        y=df["Predicted_Sales"],
        mode="lines",
        name="Regression Trendline",
        line=dict(color="#ff7f0e", dash="dash"),
    )
)

# Plot Future Forecast
fig.add_trace(
    go.Scatter(
        x=future_df["Date"],
        y=future_df["Sales"],
        mode="lines+markers",
        name="Future Forecast",
        line=dict(color="#2ca02c", width=3),
    )
)

fig.update_layout(
    xaxis_title="Date", yaxis_title="Sales ($)", hovermode="x unified"
)
st.plotly_chart(fig, use_container_width=True)

# 7. Data Preview
with st.expander("📄 View Forecast Data Table"):
    st.dataframe(future_df[["Date", "Sales"]])
